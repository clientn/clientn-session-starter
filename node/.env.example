# Copy to .env and fill in. Never commit the real values.
# From https://clientn.com/dev after you register your site and verify its domain.
CLIENTN_API_KEY=replace-with-the-32-hex-character-api-key
CLIENTN_API_SECRET=replace-with-your-cnsk_-secret
# Where your app lives. Must be https in production.
APP_ORIGIN=https://app.example.com
# Optional
# Bind address. Keep 127.0.0.1 behind a reverse proxy on the same machine.
HOST=127.0.0.1
PORT=3000
DB_PATH=./data/app.sqlite
CLIENTN_API_BASE=https://clientn.com
